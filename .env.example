# ==========================================
# GOATHIDES Luxury E-Commerce Configuration
# ==========================================

# Port details
PORT=5000
NODE_ENV=development

# Database connection details
# Docker Compose will launch a PostgreSQL container using these credentials
DB_USER=goathides_admin
DB_PASSWORD=SecureGoatPass99!
DB_NAME=goathides_db
DATABASE_URL="postgresql://goathides_admin:SecureGoatPass99!@db:5432/goathides_db?schema=public"

# JSON Web Token Secret
JWT_SECRET=supersecretgoatkey_replace_in_production

# Cloudinary credentials (for image uploads)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Next.js API url (frontend configuration)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Stripe payments keys
STRIPE_PUBLISHER_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder

# Razorpay payments keys
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_test_secret_placeholder

# PayPal payments keys
PAYPAL_CLIENT_ID=paypal_test_id
PAYPAL_CLIENT_SECRET=paypal_test_secret
